! Stokes flow in the lid-driven unit cavity, Q2-Q1 (hierarchic p:2 velocity on a bilinear mesh)
Header
  Mesh DB "." "../../../meshes/cavity_64x64"
  Results Directory ""
End
Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 2D
  Simulation Type = Steady state
  Steady State Max Iterations = 1
End
Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(1) = 1
  Element = "p:2"
End
Solver 1
  Equation = "Navier-Stokes"
  Procedure = "IncompressibleNSVec" "IncompressibleNSSolver"
  Variable = "Flow Solution[Velocity:2 Pressure:1]"
  Stokes Flow = True
  Element = "p:2"
  Solver Timing = True
  Linear System Timing = True
  Nonlinear System Max Iterations = 1
  Linear System Solver = Direct
  Linear System Direct Method = MUMPS
End
Solver 2
  Exec Solver = Always
  Equation = Result Output
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = Elmer_MUMPS
  Output Format = Vtu
  Binary Output = True  ! full double precision (the ASCII output has 8 significant digits)
  Single Precision = False
End
Material 1
  Density = 1
  Viscosity = 1
End
! Lid first, walls after: the zero-velocity walls win at the two lid corners, as in FEAScript
Boundary Condition 1
  Target Boundaries(1) = 3
  Velocity 1 = 1
  Velocity 2 = 0
End
Boundary Condition 2
  Target Boundaries(3) = 1 2 4
  Velocity 1 = 0
  Velocity 2 = 0
End
! Pressure fixed to 0 at (0, 0), as in FEAScript
Boundary Condition 3
  Target Nodes(1) = 1
  Pressure = 0
End
! The zero-velocity walls win at the two lid corners, as in FEAScript
Boundary Condition 4
  Target Nodes(2) = 4161 4225
  Velocity 1 = 0
  Velocity 2 = 0
End
